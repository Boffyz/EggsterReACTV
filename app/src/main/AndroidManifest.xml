        <provider
                android:authorities="areeb.xposed.eggster"
                android:name=".preferences.XPreferenceProvider"
                android:exported="true"/>
        <!-- Oreo octopus aquarium, ported from AOSP -->
        <activity
                android:name=".eggs.oreo.PlatLogoActivity"
                android:exported="true"
                android:label="Oreo"
                android:theme="@style/Theme.Wallpaper"/>

        <activity
                android:name=".eggs.oreo.Ocquarium"
                android:exported="false"
                android:label="Oreo"
                android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen"/>

        <!-- Pie: PAINT.APK, ported from AOSP -->
        <activity
                android:name=".eggs.pie.PlatLogoActivity"
                android:exported="true"
                android:label="Pie"
                android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen"/>

        <activity
                android:name=".eggs.pie.PaintActivity"
                android:exported="false"
                android:label="Pie"
                android:configChanges="orientation|keyboardHidden|screenSize|uiMode"
                android:theme="@style/PaintTheme"/>

        <!-- Android 10: the 1 and 0 puzzle, unlocks the Icon Quiz (Quares), ported from AOSP -->
        <activity
                android:name=".eggs.ten.PlatLogoActivity"
                android:exported="true"
                android:label="Android 10"
                android:theme="@style/TenTheme"/>

        <activity
                android:name=".eggs.ten.QuaresActivity"
