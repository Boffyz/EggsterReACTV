        <activity
                android:name=".eggs.twelve.PlatLogoActivity"
                android:exported="true"
                android:label="Android 12"
                android:theme="@style/Theme.Wallpaper"/>

        <activity
                android:name=".eggs.thirteen.PlatLogoActivity"
                android:exported="true"
                android:label="Android 13"
                android:theme="@style/Theme.Wallpaper"/>

        <!-- Android 11: the dial that goes to 11 (unlocks Neko), ported from AOSP -->
        <activity
                android:name=".eggs.eleven.PlatLogoActivity"
                android:exported="true"
                android:label="Android 11"
                android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen"/>

        <!-- Oreo 8.1: same octopus, cookie logo -->
        <activity
                android:name=".eggs.oreo81.PlatLogoActivity"
                android:exported="true"
                android:label="Oreo 8.1"
                android:theme="@style/Theme.Wallpaper"/>

        <!-- Neko (Nougat cat collector), ported from AOSP -->
        <activity
                android:name=".eggs.neko.PlatLogoActivity"
                android:exported="true"
                android:label="Neko"
                android:excludeFromRecents="true"
                android:theme="@android:style/Theme.NoDisplay"/>

        <activity
                android:name=".eggs.neko.NekoLand"
                android:exported="true"
                android:label="Neko"
                android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>

        <activity
                android:name=".eggs.neko.NekoLockedActivity"
                android:excludeFromRecents="true"
                android:exported="false"
                android:showWhenLocked="true"
                android:theme="@android:style/Theme.Material.Light.Dialog.NoActionBar"/>

        <service
                android:name=".eggs.neko.NekoService"
                android:enabled="true"
                android:exported="true"
                android:permission="android.permission.BIND_JOB_SERVICE"/>

        <service
                android:name=".eggs.neko.NekoTile"
                android:enabled="true"
                android:exported="true"
                android:icon="@drawable/stat_icon"
                android:label="@string/default_tile_name"
                android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
        </service>

        <provider
                android:name="androidx.core.content.FileProvider"
                android:authorities="areeb.xposed.eggster.fileprovider"
                android:exported="false"
                android:grantUriPermissions="true">
            <meta-data
                    android:name="android.support.FILE_PROVIDER_PATHS"
                    android:resource="@xml/neko_filepaths"/>
        </provider>

        <!-- Screensavers (Extras section): settings page, full-screen preview, and the system screensaver -->
        <activity
                android:name=".screensavers.ScreensaversActivity"
                android:exported="true"
                android:label="@string/ss_title"
                android:theme="@style/AppTheme.NoActionBar"/>

        <activity
                android:name=".screensavers.ScreensaverPreviewActivity"
                android:exported="false"
                android:configChanges="orientation|screenSize|keyboardHidden"
                android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen"/>

        <service
                android:name=".screensavers.FlyingDreamService"
                android:exported="true"
                android:icon="@mipmap/ic_launcher"
                android:label="@string/ss_dream_label"
                android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
            <meta-data
                    android:name="android.service.dream"
                    android:resource="@xml/flying_dream"/>
        </service>

